#include <windows.h>
#include "resource.h"

IDR_MANIFEST RT_MANIFEST "app.manifest"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",        IDM_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",           IDM_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+Shift+S", IDM_FILE_SAVEAS
        MENUITEM "Save A&ll Tabs",          IDM_FILE_SAVEALL
        MENUITEM SEPARATOR
        MENUITEM "&Close Tab\tCtrl+W",      IDM_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           IDM_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",           IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "&Copy Hex\tCtrl+C",       IDM_EDIT_COPY
        MENUITEM "&Paste Hex\tCtrl+V",      IDM_EDIT_PASTE
        MENUITEM "&Delete\tDel",            IDM_EDIT_DELETE
        MENUITEM "Select &All\tCtrl+A",     IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",        IDM_EDIT_FIND
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "Limpiar rastros de archivos borrados...", IDM_TOOLS_WIPE_EDITOR_TEMPS
        MENUITEM "Limpieza rapida (sin barrido completo)...", IDM_TOOLS_QUICK_WIPE
        MENUITEM SEPARATOR
        MENUITEM "Limpiar espacio libre (Wipe)...",  IDM_TOOLS_WIPE_FREE_SPACE
        MENUITEM SEPARATOR
        MENUITEM "Diagnostico: volcar carpeta cruda...", IDM_TOOLS_DUMP_FOLDER_RAW
        MENUITEM SEPARATOR
        MENUITEM "Escaneo profundo (riesgo alto)...", IDM_TOOLS_DEEP_SCAN_ALLOCATED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Hex Editor",       IDM_HELP_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "O",    IDM_FILE_OPEN,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVE,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVEAS,    VIRTKEY, CONTROL, SHIFT
    "W",    IDM_FILE_CLOSE,     VIRTKEY, CONTROL
    "Z",    IDM_EDIT_UNDO,      VIRTKEY, CONTROL
    "Y",    IDM_EDIT_REDO,      VIRTKEY, CONTROL
    "A",    IDM_EDIT_SELECTALL, VIRTKEY, CONTROL
    "C",    IDM_EDIT_COPY,      VIRTKEY, CONTROL
    "V",    IDM_EDIT_PASTE,     VIRTKEY, CONTROL
    "F",    IDM_EDIT_FIND,      VIRTKEY, CONTROL
    VK_F3,  IDM_EDIT_FIND,      VIRTKEY, NOINVERT
    VK_TAB, IDM_FILE_NEXTTAB,   VIRTKEY, CONTROL
    VK_TAB, IDM_FILE_PREVTAB,   VIRTKEY, CONTROL, SHIFT
    VK_NEXT, IDM_FILE_NEXTTAB,  VIRTKEY, CONTROL
    VK_PRIOR, IDM_FILE_PREVTAB, VIRTKEY, CONTROL
END

IDD_FIND DIALOGEX 0, 0, 240, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Search for", -1, 7, 4, 226, 46
    AUTORADIOBUTTON "&Hex bytes (e.g. DE AD BE EF)", IDC_FIND_MODE_HEX, 14, 16, 210, 10, WS_GROUP
    AUTORADIOBUTTON "&Text (ASCII)",                 IDC_FIND_MODE_TEXT, 14, 30, 210, 10
    EDITTEXT        IDC_FIND_PATTERN, 7, 54, 226, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Case sensitive", IDC_FIND_CASESENS, 7, 72, 100, 10
    LTEXT           "", IDC_FIND_STATUS, 7, 86, 226, 12
    DEFPUSHBUTTON   "Find &Next",  IDC_FIND_NEXT, 7,  102, 60, 14
    PUSHBUTTON      "Find &Previous", IDC_FIND_PREV, 72, 102, 70, 14
    PUSHBUTTON      "Close",       IDC_FIND_CLOSE, 173, 102, 60, 14
END
